# Personal Site .gitignore

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
*.swp
*.bak
*~
.idea/
.vscode/

# Private notes & credentials
Info Dump.txt
Info_Dump.txt
*Info*Dump*
*.env
*.env.*

# Resumes, Reports & LaTeX sources
*.pdf
*.tex
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Hidden personal writing archives
content/
writing/
writing.html

# Local build generators & shared modules (GitHub Pages serves static HTML only)
build_site.py
build_writing.py
shared_components.py
make_clean_commits.py

# Unused root metadata
robots.txt
favicon.ico
sitemap.xml

# Test runners, QA suites & Reports
reports/
tests/
scratch/
node_modules/
package.json
package-lock.json

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
